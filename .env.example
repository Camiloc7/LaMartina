# =============================================================================
# La Martina — Variables de Entorno
# Copia este archivo como .env.local (frontend) y .env (backend/api)
# =============================================================================

# -----------------------------------------------------------------------------
# BASE DE DATOS (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://lamartina_user:tu_password@localhost:5432/lamartina_db
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=lamartina_user
DB_PASSWORD=tu_password_segura
DB_NAME=lamartina_db
# En producción usa la CA del proveedor para validar el certificado de PostgreSQL.
DB_SSL_CA=

# -----------------------------------------------------------------------------
# CLOUDINARY — Gestión de medios e imágenes
# Obtén estas credenciales en: https://console.cloudinary.com
# 1. Regístrate en cloudinary.com (plan Free incluye 25GB storage)
# 2. Dashboard → copia Cloud Name, API Key y API Secret
# 3. Para uploads desde el frontend (sin exponer el API Secret):
#    Settings → Upload → Add upload preset → Tipo: Unsigned
#    Restringe el preset: carpeta fija, formatos permitidos, tamaño máximo,
#    sin sobrescritura y con una política de entrega acorde al contenido.
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
CLOUDINARY_UPLOAD_PRESET=lamartina_unsigned

# Solo para el frontend (Next.js) — NEXT_PUBLIC_ se expone al cliente
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=tu_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=lamartina_unsigned

# -----------------------------------------------------------------------------
# AUTENTICACIÓN JWT
# Genera un secret seguro con: openssl rand -base64 64
# -----------------------------------------------------------------------------
JWT_SECRET=cambia_esto_por_un_secret_muy_largo_y_seguro
JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
API_PORT=3001
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Actívalo únicamente detrás de un proxy inverso confiable.
TRUST_PROXY=false
